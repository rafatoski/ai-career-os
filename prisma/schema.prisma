generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProjectProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id                   Int       @id @default(autoincrement())
  lessonKey            String    @unique
  moduleSlug           String
  lessonId             String
  playbackSeconds      Float     @default(0)
  videoDurationSeconds Int       @default(0)
  watchedPercent       Int       @default(0)
  videoCompleted       Boolean   @default(false)
  notesRead            Boolean   @default(false)
  quizPassed           Boolean   @default(false)
  quizScore            Int       @default(0)
  quizAnswers          String    @default("{}")
  completed            Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([moduleSlug, lessonId])
  @@index([completed])
}

model LessonNote {
  id         Int      @id @default(autoincrement())
  lessonKey  String   @unique
  moduleSlug String
  lessonId   String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}

model ProjectProgress {
  id         Int                   @id @default(autoincrement())
  moduleSlug String                @unique
  lessonKey  String
  githubUrl  String                @default("")
  status     ProjectProgressStatus @default(NOT_STARTED)
  completed  Boolean               @default(false)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}
